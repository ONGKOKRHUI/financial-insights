# Use the official Apache Airflow image with Python 3.11 pre-installed
FROM apache/airflow:2.9.3-python3.11

# Switch to root user to install system-level dependencies
USER root

# Update package list, install curl (for making HTTP requests), 
# and clean up to keep the image small
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Switch back to the airflow user for security (best practice)
USER airflow

# Install additional Python libraries needed for your workflows
RUN pip install --no-cache-dir \
    langchain-google-genai \   
    langchain \               
    langchain-text-splitters \
    langgraph \             
    langfuse \              
    llama-cloud \       
    pymupdf \            
    python-dotenv \    
    requests \          
    pydantic \           
    sqlalchemy \            
    psycopg2-binary   