# Copy this file to .env and fill in values for local development.
# The docker-compose.yml uses these defaults automatically.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# Comma-separated list of allowed CORS origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000

# Public-facing backend URL (used by Next.js browser-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal backend URL (used by Next.js server-side / SSR fetches inside Docker)
INTERNAL_API_URL=http://backend:8000
