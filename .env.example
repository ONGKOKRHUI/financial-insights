# Copy this file to .env and fill in values for LOCAL DEVELOPMENT only.
# The docker-compose.yml reads these values automatically.
#
# For PRODUCTION, do NOT use this file — set environment variables directly in:
#   - Render dashboard  → backend vars (DATABASE_URL, ALLOWED_ORIGINS, COOKIE_SECURE)
#   - Vercel dashboard  → frontend vars (NEXT_PUBLIC_API_URL, INTERNAL_API_URL)
#   - Supabase provides the DATABASE_URL value

# ── Local Development ──────────────────────────────────────────────────────────
#
# IMPORTANT: When running WITHOUT Docker Compose (plain `uvicorn` + `npm run dev`):
#   1. Change INTERNAL_API_URL to http://localhost:8000 (not http://backend:8000)
#   2. Set COOKIE_SECURE=false so the backend sets cookies over plain HTTP
#
# When running WITH Docker Compose, use the values shown as-is.

# PostgreSQL connection string (local Docker container or plain local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# Allowed CORS origins for the FastAPI backend.
# LOCAL:      http://localhost:3000
# PRODUCTION: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Backend URL used by Next.js browser-side code (baked into the JS bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for Next.js server-side BFF Route Handlers.
# Docker Compose:         http://backend:8000   ← service name in docker network
# Plain local dev:        http://localhost:8000
# Vercel (production):    https://your-api.onrender.com  ← set in Vercel dashboard
INTERNAL_API_URL=http://localhost:8000

# ── Phase 4: Auth (backend — Render) ─────────────────────────────────────────
# Generate a secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256

# Set to "false" for local HTTP development (http://localhost).
# Leave unset or set to "true" for production HTTPS deployments.
# If cookies are not being set during login, check this value first.
COOKIE_SECURE=false

# ── Phase 4: Stripe (backend — Render + frontend — Vercel) ───────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get signing secret from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Get price ID from: Stripe Dashboard → Products → FinSight Pro → Price ID
STRIPE_PRO_PRICE_ID=price_...
# Frontend base URL for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Phase 4: Integration Test ─────────────────────────────────────────────────
# Set these after manually creating an admin account (see README)
FINSIGHT_ADMIN_EMAIL=admin@yourcompany.com
FINSIGHT_ADMIN_PASSWORD=the_generated_password_from_registration

# ── Production Reference (set in dashboards, not here) ────────────────────────
# Render  → DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Render  → ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Render  → SECRET_KEY=<generated>
# Render  → COOKIE_SECURE=true  (default; omit for production)
# Render  → STRIPE_SECRET_KEY=sk_live_...
# Render  → STRIPE_WEBHOOK_SECRET=whsec_...
# Vercel  → NEXT_PUBLIC_API_URL=https://finsight-api.onrender.com
# Vercel  → INTERNAL_API_URL=https://finsight-api.onrender.com  ← REQUIRED for BFF routes
# Vercel  → STRIPE_SECRET_KEY=sk_live_... (BFF checkout route)
# Vercel  → STRIPE_PRO_PRICE_ID=price_...
# Vercel  → NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ══════════════════════════════════════════════════════════════════════════════
# ETL Pipeline — Phase 2 (src/pipeline/ + dags/)
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM: Google Gemini ────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Note: Google API keys start with "AIzaSy..." — verify your key format.
GOOGLE_API_KEY=Al...
GEMINI_MODEL=gemini-2.0-flash

# ── LlamaCloud (LlamaParse PDF → Markdown) ────────────────────────────────────
# Get your key at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...

# ── Langfuse Observability ────────────────────────────────────────────────────
# Get your keys at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Pipeline Engine Toggle ────────────────────────────────────────────────────
# "langgraph" → native LangGraph + Gemini extraction (default)
# "dify"      → route parsed markdown to a Dify Workflow API instead
PIPELINE_ENGINE=langgraph

# ── Dify (only required when PIPELINE_ENGINE=dify) ───────────────────────────
DIFY_API_URL=https://api.dify.ai/v1/workflows/run
DIFY_API_KEY=app-...

# ── PDF Input Directory ───────────────────────────────────────────────────────
# The scraper writes to src/scraper/data/raw/<COMPANY>/<COMPANY>_<YEAR>_<QUARTER>.pdf
# Override this if you want the DAG to watch a different directory.
FINSIGHT_RAW_DIR=src/scraper/data/raw

# ── Airflow (docker-compose.airflow.yml) ─────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=finsight-airflow-dev-secret
