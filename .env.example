# Copy this file to .env and fill in values for LOCAL DEVELOPMENT only.
# The docker-compose.yml reads these values automatically.
#
# For PRODUCTION, do NOT use this file — set environment variables directly in:
#   - Render dashboard  → backend vars (DATABASE_URL, ALLOWED_ORIGINS)
#   - Vercel dashboard  → frontend vars (NEXT_PUBLIC_API_URL)
#   - Supabase provides the DATABASE_URL value

# ── Local Development (Docker Compose) ────────────────────────────────────────

# PostgreSQL connection string (local Docker container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# Allowed CORS origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000

# Backend URL used by Next.js browser-side code (build-time baked into JS bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for Next.js server-side Route Handlers inside Docker network
INTERNAL_API_URL=http://backend:8000

# ── Production Reference (set in dashboards, not here) ────────────────────────
# Render  → DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Render  → ALLOWED_ORIGINS=https://your-app.vercel.app
# Vercel  → NEXT_PUBLIC_API_URL=https://finsight-api.onrender.com

# ══════════════════════════════════════════════════════════════════════════════
# ETL Pipeline — Phase 2 (src/pipeline/ + dags/)
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM: Google Gemini ────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Note: Google API keys start with "AIzaSy..." — verify your key format.
GOOGLE_API_KEY=Al...
GEMINI_MODEL=gemini-2.0-flash

# ── LlamaCloud (LlamaParse PDF → Markdown) ────────────────────────────────────
# Get your key at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...

# ── Langfuse Observability ────────────────────────────────────────────────────
# Get your keys at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Pipeline Engine Toggle ────────────────────────────────────────────────────
# "langgraph" → native LangGraph + Gemini extraction (default)
# "dify"      → route parsed markdown to a Dify Workflow API instead
PIPELINE_ENGINE=langgraph

# ── Dify (only required when PIPELINE_ENGINE=dify) ───────────────────────────
DIFY_API_URL=https://api.dify.ai/v1/workflows/run
DIFY_API_KEY=app-...

# ── PDF Input Directory ───────────────────────────────────────────────────────
# The scraper writes to src/scraper/data/raw/<COMPANY>/<COMPANY>_<YEAR>_<QUARTER>.pdf
# Override this if you want the DAG to watch a different directory.
FINSIGHT_RAW_DIR=src/scraper/data/raw

# ── Airflow (docker-compose.airflow.yml) ─────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=finsight-airflow-dev-secret
